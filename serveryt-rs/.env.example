# ========================================
# ServerYT-RS Environment Configuration Template
# Copy this file to .env and modify as needed
# ========================================

# Server Configuration
PORT=8026

# Base URL for generating download links
# Local development
BASE_URL=http://localhost:8026

# Production deployment
# BASE_URL=https://your-domain.com

# ========================================
# Security - URL Signature (IMPORTANT!)
# ========================================

# Secret key for HMAC-SHA256 signatures
# MUST be set to a random 32+ character string in production!
SIGNATURE_SECRET=change_me_in_production_32chars!

# Signed URL expiry in seconds (default: 120 = 2 minutes)
SIGNATURE_TTL=120

# ========================================
# Rate Limiting
# ========================================

# Max requests per window per IP (default: 10)
RATE_LIMIT_REQUESTS=10

# Rate limit window in seconds (default: 60 = 1 minute)
RATE_LIMIT_WINDOW=60

# ========================================
# yt-dlp Configuration
# ========================================

# Cookies file path (optional, for authenticated downloads)
# COOKIES_PATH=./cookies/cookies.txt

# Timeouts (in seconds)
YTDLP_TIMEOUT=45
DOWNLOAD_TIMEOUT=300
