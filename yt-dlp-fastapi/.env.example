# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017/yt_dlp_db

# RabbitMQ Configuration (Celery Broker)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672/
CELERY_RESULT_BACKEND=mongodb://localhost:27017/yt_dlp_celery_results

# Redis Configuration (Rate Limiting & Caching)
REDIS_URL=redis://localhost:6379/0

# App Settings
CLEANUP_DELAY_MINUTES=5
RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=info

# For Docker deployment, use service names:
# MONGODB_URL=mongodb://mongo:27017/yt_dlp_db
# CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672/
# REDIS_URL=redis://redis:6379/0
